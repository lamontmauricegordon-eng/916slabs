{
  "rules": {
    "@typescript-eslint/no-deprecated": "error",
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "glob",
            "message": "Use 'glob@10.x.x' or a maintained alternative. 'glob@7.2.3' is deprecated."
          },
          {
            "name": "rimraf",
            "message": "Use 'rimraf@4.x.x' instead."
          }
        ]
      }
    ]
  }
}
